# =============================================================================
# Root .env.example -- documents every environment variable used across the
# monorepo. Each app also has its own .env.example with the subset (and the
# EXPO_PUBLIC_ / NEXT_PUBLIC_ prefixes) it actually needs.
#
# Copy to .env.local per app, never commit real values. In Supabase, the
# anon key is safe to ship to a client; the service role key never is.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role: server-side / Edge Functions ONLY. Never prefix this with
# EXPO_PUBLIC_ or NEXT_PUBLIC_ -- that would ship it to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (abstracted -- see packages/ai in a later phase) ----------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Stripe (Phase 12: deposits + platform subscription billing) -----------
# Secret key: Edge Functions ONLY (create-deposit-payment-intent,
# capture-noshow-deposit, refund-deposit, create-subscription-checkout,
# stripe-webhook). Never prefix with EXPO_PUBLIC_ / NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Webhook signing secret, from the Stripe dashboard's webhook endpoint
# config (or `stripe listen` in local dev). stripe-webhook only.
STRIPE_WEBHOOK_SECRET=
# Publishable key: safe to ship to the browser -- the web app's deposit
# payment step (Stripe Elements) needs it client-side.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Environment tag (dev | staging | production) --------------------------
APP_ENV=dev
