# =============================================================================
# Root .env.example -- documents every environment variable used across the
# monorepo. Each app also has its own .env.example with the subset (and the
# EXPO_PUBLIC_ / NEXT_PUBLIC_ prefixes) it actually needs.
#
# Copy to .env.local per app, never commit real values. In Supabase, the
# anon key is safe to ship to a client; the service role key never is.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role: server-side / Edge Functions ONLY. Never prefix this with
# EXPO_PUBLIC_ or NEXT_PUBLIC_ -- that would ship it to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (abstracted -- see packages/ai) ----------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional -- packages/ai/src/providers/anthropic.ts falls back to sane
# defaults (claude-haiku-4-5 / claude-sonnet-4-5) if these are unset. Verify
# the current model catalogue at https://docs.claude.com before overriding.
ANTHROPIC_MODEL_SMALL=
ANTHROPIC_MODEL_LARGE=

# --- Stripe (Phase 12: deposits + platform subscription billing) -----------
# Secret key: Edge Functions ONLY (create-deposit-payment-intent,
# capture-noshow-deposit, refund-deposit, create-subscription-checkout,
# stripe-webhook). Never prefix with EXPO_PUBLIC_ / NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Webhook signing secret, from the Stripe dashboard's webhook endpoint
# config (or `stripe listen` in local dev). stripe-webhook only.
STRIPE_WEBHOOK_SECRET=
# Publishable key: safe to ship to the browser -- the web app's deposit
# payment step (Stripe Elements) needs it client-side.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Twilio (Phase 11: voice readiness) -------------------------------------
# Used only to verify the X-Twilio-Signature header on inbound calls
# (voice-webhook) -- never sent anywhere, never logged. Edge Function only.
TWILIO_AUTH_TOKEN=

# --- Environment tag (dev | staging | production) --------------------------
APP_ENV=dev

# --- Phase 17: GitHub Actions repository secrets (NOT read from this file --
# documented here so this remains the one place that lists every credential
# the project needs, dev or CI/CD). Set under GitHub repo Settings -> Secrets
# and variables -> Actions -> "production" environment (deploy.yml's
# `environment: production` lets these be gated behind required reviewers,
# separate from ci.yml's placeholder-only build). See README's Phase 17
# section for the full runbook.
#   SUPABASE_ACCESS_TOKEN   -- personal/CI access token, Supabase dashboard
#                              -> Account -> Access Tokens.
#   SUPABASE_PROJECT_REF    -- the production project's ref (Project
#                              Settings -> General).
#   SUPABASE_DB_PASSWORD    -- the production project's database password
#                              (set at project creation, or reset from
#                              Project Settings -> Database).
# Edge Function secrets (ANTHROPIC_API_KEY, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, TWILIO_AUTH_TOKEN) are set ONCE by hand via
# `supabase secrets set`, not stored as GitHub secrets or re-applied on
# every deploy -- see deploy.yml's own header comment for why.
