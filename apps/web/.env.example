# Next.js only exposes vars prefixed NEXT_PUBLIC_ to the browser bundle.
# Copy to .env.local. The service_role key never belongs in this app --
# server-side routes that need it should call Supabase Edge Functions
# instead of embedding the key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Phase 12: Stripe publishable key for the public booking page's deposit
# payment step (Stripe Elements). Safe to ship to the browser -- it is not
# a secret, it only identifies which Stripe account to talk to.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Phase 6, Part 2c (Live Availability upgrade -- self-service waitlist Web
# Push): the PUBLIC half of the VAPID keypair generated for migration 0030
# (`npx web-push generate-vapid-keys`). Safe to ship to the browser -- it is
# not a secret, it only identifies this app to the push service, exactly
# like the Stripe publishable key above. The PRIVATE half is an Edge
# Function secret only (VAPID_PRIVATE_KEY, notify-waitlist) and must never
# appear in this file or anywhere in the browser bundle. Used by
# src/lib/webPush.ts to open a PushManager subscription when a guest
# explicitly opts in from the "Join waitlist" panel (BookingForm.tsx).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
