# Next.js only exposes vars prefixed NEXT_PUBLIC_ to the browser bundle.
# Copy to .env.local. The service_role key never belongs in this app --
# server-side routes that need it should call Supabase Edge Functions
# instead of embedding the key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Phase 12: Stripe publishable key for the public booking page's deposit
# payment step (Stripe Elements). Safe to ship to the browser -- it is not
# a secret, it only identifies which Stripe account to talk to.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
