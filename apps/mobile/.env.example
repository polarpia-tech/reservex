# Expo only exposes vars prefixed EXPO_PUBLIC_ to the client bundle.
# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard). Never put the
# service_role key here -- it belongs only in Edge Functions.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
