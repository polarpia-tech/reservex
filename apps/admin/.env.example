# Next.js only exposes vars prefixed NEXT_PUBLIC_ to the browser bundle.
# Copy to .env.local. The service_role key never belongs in this app -- every
# privileged operation here goes through a SECURITY DEFINER SQL function
# (admin_suspend_restaurant, admin_set_subscription, admin_grant_platform_admin,
# etc. -- see supabase/migrations/0020_platform_admin.sql), callable with the
# same anon key as every other client, because is_platform_admin() is checked
# INSIDE each function, not via a service-role bypass.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
